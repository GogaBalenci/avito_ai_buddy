          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE payload->>'intent'\n  WHEN 'help' THEN 'Что ты умеешь' WHEN 'my_path' THEN 'Мой путь' WHEN 'step_explain' THEN 'Объяснить шаг'\n  WHEN 'step_done' THEN 'Отметить шаг' WHEN 'kb_question' THEN 'Вопрос по базе знаний' WHEN 'time_off' THEN 'Отгул'\n  WHEN 'access_request' THEN 'Доступ' WHEN 'my_requests' THEN 'Мои заявки' WHEN 'ask_mentor' THEN 'Спросить наставника'\n  WHEN 'out_of_scope' THEN 'Вне прототипа' WHEN 'unknown' THEN 'Не понял' ELSE coalesce(payload->>'intent','—') END AS \"Намерение\", count(*) AS \"Ответов\"\nFROM app.events WHERE name='reply_sent' AND $__timeFilter(ts) GROUP BY 1 ORDER BY 2 DESC"
