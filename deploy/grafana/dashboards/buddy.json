    {
      "type": "bargauge",
      "title": "Воронка отгула (S3)",
      "description": "Форма открыта → черновик проверен → заявка создана. Падение между шагами — где стажёр бросает оформление.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "buddy-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT step AS \"Шаг\", n AS \"Событий\" FROM (\n  SELECT 1 AS o, 'Форма открыта' AS step, count(*) AS n FROM app.events WHERE name='time_off_form_opened' AND $__timeFilter(ts)\n  UNION ALL SELECT 2, 'Черновик проверен', count(*) FROM app.events WHERE name='action_drafted' AND payload->>'kind'='time_off' AND $__timeFilter(ts)\n  UNION ALL SELECT 3, 'Ошибка в датах', count(*) FROM app.events WHERE name='time_off_validation_failed' AND $__timeFilter(ts)\n  UNION ALL SELECT 4, 'Заявка создана', count(*) FROM app.events WHERE name='action_completed' AND payload->>'kind'='time_off' AND $__timeFilter(ts)\n) t ORDER BY o"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
