    {
      "type": "table",
      "title": "Заявки на доступ: кто решил и сколько ждали",
      "description": "access_request_decided: сразу, по таймеру или наставником; среднее ожидание в минутах",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "buddy-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE payload->>'decided_by' WHEN 'auto' THEN 'Сразу (правило)' WHEN 'timer' THEN 'По таймеру' WHEN 'mentor' THEN 'Наставник' ELSE '—' END AS \"Кто решил\",\n  count(*) FILTER (WHERE payload->>'decision'='approve') AS \"Одобрено\",\n  count(*) FILTER (WHERE payload->>'decision'='reject') AS \"Отклонено\",\n  round(avg((payload->>'wait_ms')::numeric) / 60000, 1) AS \"Ожидание, мин\"\nFROM app.events WHERE name='access_request_decided' AND $__timeFilter(ts) GROUP BY 1 ORDER BY 2 DESC"
        }
      ],
