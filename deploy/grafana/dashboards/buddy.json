    {
      "type": "bargauge",
      "title": "Эскалации к наставнику по причинам",
      "description": "escalated: когда бадди честно передаёт вопрос наставнику вместо догадки (09 §8.2)",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "buddy-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE payload->>'reason'\n  WHEN 'explicit' THEN 'Попросили наставника' WHEN 'no_answer' THEN 'Нет ответа в базе'\n  WHEN 'no_source_term' THEN 'Термин без источника' WHEN 'permission_denied' THEN 'Отказ по правам'\n  WHEN 'not_understood' THEN 'Не понял дважды' WHEN 'negative_feedback' THEN 'Дважды «Не то»'\n  WHEN 'mentor_topic' THEN 'Тема для 1:1' ELSE coalesce(payload->>'reason','—') END AS \"Причина\",\n  count(*) AS \"Эскалаций\"\nFROM app.events WHERE name='escalated' AND $__timeFilter(ts) GROUP BY 1 ORDER BY 2 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
