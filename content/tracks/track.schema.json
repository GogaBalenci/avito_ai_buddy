{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tracks/track.schema.json",
  "title": "Track",
  "description": "Формат файла трека адаптации (docs/08-intern-journey.md, раздел «Треки», schema_version 1).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title", "kind", "synthetic", "source", "steps"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "kind": { "enum": ["common", "direction"] },
    "extends": { "const": "common" },
    "synthetic": { "type": "boolean" },
    "disclaimer": { "type": "string" },
    "source": { "type": "string", "minLength": 1 },
    "periods": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "from_day", "to_day"],
        "properties": {
          "id": { "enum": ["week1", "week2", "month1", "month2", "month3", "after3"] },
          "title": { "type": "string", "minLength": 1 },
          "from_day": { "type": "integer", "minimum": 1 },
          "to_day": { "type": ["integer", "null"], "minimum": 1 }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "period", "order", "title", "type", "owner", "help"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z]{2}-[a-z0-9.-]{1,20}$" },
          "checklist_ref": { "type": "string", "pattern": "^\\d\\.\\d{1,2}$" },
          "period": { "type": "string" },
          "order": { "type": "integer", "minimum": 0 },
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "type": { "enum": ["learn", "setup", "access", "meet", "tell", "org"] },
          "owner": { "enum": ["intern", "mentor", "lead", "curator"] },
          "synthetic": { "type": "boolean" },
          "help": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": {
              "kind": { "enum": ["explain", "access_request", "ask_mentor", "track_only"] },
              "kb_doc": { "type": "string", "pattern": "^[a-z0-9-]{2,60}$" },
              "source_level": { "enum": ["playbook", "case", "public", "none"] },
              "resource": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,40}$" }
            },
            "allOf": [
              { "if": { "properties": { "kind": { "const": "explain" } } },
                "then": { "required": ["kb_doc", "source_level"] } },
              { "if": { "properties": { "kind": { "const": "access_request" } } },
                "then": { "required": ["resource"] } }
            ]
          }
        }
      }
    }
  },
  "allOf": [
    { "if": { "properties": { "kind": { "const": "direction" } } },
      "then": { "required": ["extends"], "not": { "required": ["periods"] } } },
    { "if": { "properties": { "kind": { "const": "common" } } },
      "then": { "required": ["periods"] } },
    { "if": { "properties": { "synthetic": { "const": true } } },
      "then": { "required": ["disclaimer"], "properties": { "disclaimer": { "minLength": 1 } } } }
  ]
}
