{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "absences/list_requests.input.v1.json",
  "title": "absences.list_requests input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "actor"
  ],
  "properties": {
    "actor": {
      "$ref": "../common/actor.v1.json"
    },
    "employee_id": {
      "type": "string",
      "pattern": "^u-[a-z0-9-]{1,40}$"
    },
    "statuses": {
      "type": "array",
      "items": {
        "enum": [
          "registered",
          "cancelled"
        ]
      },
      "uniqueItems": true,
      "default": [
        "registered"
      ]
    },
    "date_to_gte": {
      "type": "string",
      "format": "date"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50,
      "default": 20
    }
  }
}
