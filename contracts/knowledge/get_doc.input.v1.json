{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledge/get_doc.input.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "actor",
    "slug"
  ],
  "properties": {
    "actor": {
      "$ref": "../common/actor.v1.json"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]{2,60}$"
    }
  }
}
