{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledge/search.input.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "actor",
    "query"
  ],
  "properties": {
    "actor": {
      "$ref": "../common/actor.v1.json"
    },
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "track": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "period": {
          "type": "string",
          "enum": [
            "week1",
            "week2",
            "month1",
            "month2",
            "month3",
            "after3"
          ]
        }
      }
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "default": 3
    }
  }
}
